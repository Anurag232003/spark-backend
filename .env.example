# Environment Mode (development | production)
ENVIRONMENT=development

# Enforce HTTPS, HSTS (Strict-Transport-Security) & Secure WebSockets (wss://)
# In production, set to true to redirect all HTTP traffic to HTTPS, inject HSTS headers,
# and strictly reject unencrypted WebSocket connections.
ENFORCE_HTTPS=false

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/?appName=Cluster0

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration (comma-separated allowed origins - use https:// in production)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://app.sparkdating.com

# Admin Moderation System
# Comma-separated E.164 phone numbers that are auto-promoted to admin role on first login.
# Only these users can access /api/admin/* endpoints.
# Example: ADMIN_PHONE_NUMBERS=+919876543210,+14155550000
ADMIN_PHONE_NUMBERS=

# Firebase Admin Authentication (10,000 Free Phone Verifications / Month)
# Download service account key from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

